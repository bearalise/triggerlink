{
  "name": "@triggerlink/sdk",
  "version": "0.4.7",
  "description": "TriggerLink TypeScript SDK: durable, crash-recoverable functions for Next.js / Node.js",
  "keywords": [
    "triggerlink",
    "durable-execution",
    "workflow",
    "background-jobs",
    "event-driven",
    "step-functions",
    "nextjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearalise/triggerlink.git",
    "directory": "sdk-ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/deepseek": "^3.0.32",
    "@ai-sdk/openai": "^4.0.42",
    "ai": "^7.0.66",
    "zhipu-ai-provider": "^0.4.0"
  }
}
